PORT=3000
# Postgres
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=globetrotter
PGPORT=5432
# or use DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace_me_dev_secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info
CACHE_NAMESPACE=gt
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=60

# Cloudinary (image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend origin (for CORS). In dev you can leave blank to allow all with credentials, or set e.g.
# FRONTEND_ORIGIN=http://localhost:5173
# If not set, server currently uses dynamic origin:true (less strict). For production set explicitly.
# FRONTEND_ORIGIN=
