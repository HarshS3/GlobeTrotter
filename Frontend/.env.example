# Vite frontend environment example
# Exposed variables must be prefixed with VITE_

# Backend API base URL (no trailing slash)
VITE_API_BASE=http://localhost:3000
# Frontend public base (useful for building absolute links, emails etc.)
VITE_APP_BASE=http://localhost:5173

# Toggle mock fallback if API unavailable (true/false)
VITE_ENABLE_MOCKS=true
